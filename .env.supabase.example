# Supabase Edge Function secrets — copy to .env (git-ignored) locally, and/or
# set each value in the Supabase dashboard (Project → Edge Functions → Secrets),
# or deploy them in bulk with the Supabase CLI:
#
#   supabase secrets set --env-file .env.supabase
#
# ---------------------------------------------------------------------------
# Required for the pipeline
# ---------------------------------------------------------------------------

# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key — keep secret!

# Stripe dashboard → Developers → API keys (secret key)
STRIPE_SECRET_KEY=sk_live_...
# Stripe Price IDs (one per product; created in Stripe → Products)
STRIPE_PRICE_ESSENTIALS=price_...
STRIPE_PRICE_COMPLETE=price_...
STRIPE_PRICE_PREMIUM_FOUNDING=price_...   # $36 one-time founding offer
# Stripe dashboard → Developers → Webhooks → your endpoint's signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Where the site lives (used for checkout success/cancel URLs, download links,
# and CORS). No trailing slash.
SITE_URL=https://pravely.com
APP_URL=https://app.pravely.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Support address shown in emails + download page
SUPPORT_EMAIL=support@pravely.com

# Signed download-link lifetime (hours, default 72) and per-license daily cap
DOWNLOAD_LINK_TTL_HOURS=72
DAILY_DOWNLOAD_LIMIT=20

# Admin key protecting preview-email (pick a long random string)
ADMIN_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Email — leave as "log" until you connect a provider. The pipeline stores the
# rendered email on the license record; preview it with the preview-email
# function. When ready: create a Resend account, verify your domain, then set
# EMAIL_PROVIDER=resend and:
#   RESEND_API_KEY=re_...
#   EMAIL_FROM="Pravely <updates@updates.pravely.com>"
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM=
